# CHECK-NEXT:        },
# CHECK-NEXT:        "start": {
# CHECK-NEXT:          "character": 19,
# CHECK-NEXT:          "line": 15
# CHECK-NEXT:        }
# CHECK-NEXT:      },
# CHECK-NEXT:      "uri": "{{.*}}/hyper.cpp"
# CHECK-NEXT:    }
# CHECK-NEXT:  ]
